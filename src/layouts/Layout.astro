---
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
	</head>
	<body>
		<div class="lcars-frame">
			<!-- ROW 1: FULL WIDTH SWOOP -->
			<div class="lcars-elbow-top"></div>
			<header class="lcars-swoop-ext">
				<span class="status-text">ONLINE // ACCESS GRANTED</span>
			</header>

			<!-- ROW 2: SIDEBAR & MAIN CONTENT -->
			<Sidebar />
			<main class="content-viewport">
				<slot />
				<footer>
					<div class="social-links">
						<a href="https://github.com/joshoney" target="_blank" rel="noopener noreferrer">GitHub</a>
						<a href="https://www.linkedin.com/in/joshua-oney-sf" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					</div>
					<p>&copy; 2026. All rights reserved.</p>
				</footer>
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0b0d10;
		--card-bg: #14181f;
		--text-main: #f0f4f8;
		--text-muted: #8b949e;
		
		/* Readable LCARS Palette */
		--lcars-amber: #ff9900;
		--lcars-blue: #6699cc;
		--lcars-purple: #cc6699;
		--lcars-red: #cc4444;
		--lcars-tan: #ffcc99;
		--lcars-dark: #1a1e24;

		--font-mono: 'Courier New', Courier, monospace;
		--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: var(--font-sans);
		line-height: 1.6;
		overflow-x: hidden;
	}

	a {
		text-decoration: none;
		color: inherit;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	/* Master LCARS Layout - Widened */
	.lcars-frame {
		display: grid;
		grid-template-columns: 300px 1fr;
		grid-template-rows: auto 1fr;
		gap: 8px 20px; /* Authentic LCARS black segmentation gaps */
		min-height: 96vh;
		max-width: 1800px;
		width: 95%;
		margin: 0 auto;
		padding-top: 20px;
	}

	/* Top Swoop Architecture */
	.lcars-elbow-top {
		width: 100%;
		height: 65px;
		background-color: var(--lcars-amber);
		border-top-left-radius: 35px;
	}

	.lcars-swoop-ext {
		width: 100%;
		height: 40px; /* Thinner than elbow corner to create the classic LCARS step */
		align-self: start;
		background-color: var(--lcars-amber);
		border-top-right-radius: 4px;
		border-bottom-right-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding-right: 25px;
	}

	.status-text {
		font-family: var(--font-mono);
		font-weight: bold;
		font-size: 0.85rem;
		color: #000;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	/* Content Area */
	.content-viewport {
		padding: 20px 2% 20px 2%;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Footer */
	footer {
		text-align: center;
		padding-top: 60px;
		margin-top: 60px;
		border-top: 1px solid #21262d;
		color: var(--text-muted);
		font-size: 0.9rem;
		font-family: var(--font-mono);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 30px;
		margin-bottom: 15px;
	}

	.social-links a {
		color: var(--lcars-amber);
		font-weight: bold;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.social-links a:hover {
		color: var(--text-main);
		text-decoration: underline;
	}

	/* Mobile Responsive */
	@media (max-width: 850px) {
		.lcars-frame {
			grid-template-columns: 1fr;
		}
		.lcars-elbow-top, .lcars-swoop-ext {
			display: none;
		}
	}
</style>