---
import Sidebar from '../components/Sidebar.astro';
import EvalsSidebar from '../components/EvalsSidebar.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	isEvalsPage?: boolean;
	activeView?: 'matrix' | 'compare' | 'run';
	activeRunId?: string;
}

const { title, isEvalsPage = false, activeView = 'matrix', activeRunId } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<div class="lcars-frame">
			<!-- ROW 1: FULL WIDTH SWOOP & CORNER ELBOW -->
			<div class="lcars-elbow-top"></div>
			<header class="lcars-swoop-ext-container">
				<div class="swoop-segment swoop-left"></div>
				<div class="swoop-segment swoop-mid"></div>
				<div class="swoop-segment swoop-right">
					<span class="status-text">{isEvalsPage ? 'EVALUER BENCH // TELEMETRY ACCESS' : 'ONLINE // ACCESS GRANTED'}</span>
				</div>
			</header>

			<!-- ROW 2: LOCKED SIDEBAR & SCROLLABLE MAIN CONTENT -->
			{isEvalsPage ? (
				<EvalsSidebar activeView={activeView} activeRunId={activeRunId} />
			) : (
				<Sidebar />
			)}
			<main class="content-viewport" style="view-transition-name: main-pane">
				<slot />
				<footer>
					<p>&copy; 2026 Josh Oney.</p>
				</footer>
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0b0d10;
		--card-bg: #14181f;
		--text-main: #f0f4f8;
		--text-muted: #8b949e;
		/* Comprehensive LCARS Palette */
		--lcars-african-violet: #baa4e5;
		--lcars-almond: #d29b7f;
		--lcars-almond-creme: #fcc19f;
		--lcars-barley: #edb378;
		--lcars-bluey: #8899ff;
		--lcars-brown: #895129;
		--lcars-butterscotch: #ea9c72;
		--lcars-dirty-mauve: #7a506d;
		--lcars-dusty-mauve: #9d698a;
		--lcars-lilac: #8a72a7;
		--lcars-mars: #ff2200;
		--lcars-orange: #eb943a;
		--lcars-red: #cf4f4f;
		--lcars-subdued-sienna: #c47d69;
		--lcars-true-mauve: #c082a9;

		/* Mapped existing variables to match the new palette */
		--lcars-amber: var(--lcars-orange);
		--lcars-blue: var(--lcars-bluey);
		--lcars-purple: var(--lcars-african-violet);
		--lcars-tan: var(--lcars-almond-creme);
		--lcars-dark: #1a1e24;

		--font-mono: 'Courier New', Courier, monospace;
		--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: var(--font-sans);
		line-height: 1.6;
		overflow: hidden; /* Prevents outer page scrolling */
	}

	a {
		text-decoration: none;
		color: inherit;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	/* Master LCARS Viewport-Locked Layout */
	.lcars-frame {
		display: grid;
		grid-template-columns: 300px 1fr;
		grid-template-rows: 70px 1fr;
		gap: 0; /* Zero gap physically fuses the top sweep and sidebar */
		height: 100vh;
		width: 100vw;
		background-color: var(--bg-color);
	}

	/* Top Swoop Architecture */
	.lcars-elbow-top {
		width: 100%;
		height: 100%;
		background-color: var(--lcars-butterscotch);
		border-top-left-radius: 35px;
	}

	.lcars-swoop-ext-container {
		display: flex;
		width: 100%;
		height: 40px; /* Leaves a 30px step down to match the 70px top row */
		align-self: start;
		gap: 6px;
	}

	.swoop-segment {
		height: 100%;
	}

	.swoop-left {
		flex: 1;
		position: relative;
		background-color: var(--lcars-butterscotch);
	}

	.swoop-mid {
		flex: 2;
		background-color: var(--lcars-dusty-mauve);
	}

	.swoop-right {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding: 0 35px 0 25px;
		background-color: var(--lcars-lilac);
		border-bottom-right-radius: 20px;
		width: 380px;
		flex-shrink: 0;
	}

	/* LCARS Smooth Inner Concave Curve (Fillet) */
	.swoop-left::after {
		content: "";
		position: absolute;
		left: 0;
		top: 40px; /* Sits directly in the 30px step below the horizontal bar */
		width: 30px;
		height: 30px;
		/* Carves an inward arc using a transparent circle centered at bottom-right */
		background: radial-gradient(circle at 100% 100%, transparent 29.5px, var(--lcars-butterscotch) 30px);
		pointer-events: none;
	}

	.status-text {
		font-family: var(--font-mono);
		font-weight: bold;
		font-size: 0.85rem;
		color: #000;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	/* Content Area - Independent Scrolling Viewport */
	.content-viewport {
		padding: 30px 6% 40px 85px;
		height: calc(100vh - 70px);
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Footer */
	footer {
		text-align: center;
		padding-top: 60px;
		margin-top: 60px;
		border-top: 1px solid #21262d;
		color: var(--text-muted);
		font-size: 0.85rem;
		font-family: var(--font-mono);
	}

	/* LCARS Scrollbars */
	::-webkit-scrollbar {
		width: 12px;
		height: 12px;
	}
	::-webkit-scrollbar-track {
		background: #0d1117;
		border-left: 1px solid #21262d;
	}
	::-webkit-scrollbar-thumb {
		background: var(--lcars-amber);
		border-radius: 6px;
		border: 3px solid #0d1117;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--lcars-tan);
	}
	::-webkit-scrollbar-corner {
		background: #0d1117;
	}

	/* Mobile Responsive */
	@media (max-width: 850px) {
		body {
			overflow: auto;
		}
		.lcars-frame {
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			height: auto;
		}
		.lcars-elbow-top, .lcars-swoop-ext-container {
			display: none;
		}
		.content-viewport {
			height: auto;
			overflow-y: visible;
			padding: 20px 5%;
	}

	/* Custom View Transitions */
	::view-transition-old(main-pane),
	::view-transition-old(sidebar-pane) {
		animation: slideUpOut 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}
	::view-transition-new(main-pane),
	::view-transition-new(sidebar-pane) {
		animation: slideDownIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	@keyframes slideUpOut {
		from { transform: translateY(0); opacity: 1; }
		to { transform: translateY(-100px); opacity: 0; }
	}
	@keyframes slideDownIn {
		from { transform: translateY(-100px); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}
</style>