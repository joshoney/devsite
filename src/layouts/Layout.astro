---
import Sidebar from '../components/Sidebar.astro';
import EvalsSidebar from '../components/EvalsSidebar.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	isEvalsPage?: boolean;
	activeView?: 'matrix' | 'compare' | 'run';
	activeRunId?: string;
}

const { title, isEvalsPage = false, activeView = 'matrix', activeRunId } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<div class="lcars-frame">
			<!-- ROW 1: FULL WIDTH SWOOP & CORNER ELBOW -->
			<div class="lcars-elbow-top"></div>
			<header class="lcars-swoop-ext">
				<span class="status-text">{isEvalsPage ? 'EVALUER BENCH // TELEMETRY ACCESS' : 'ONLINE // ACCESS GRANTED'}</span>
			</header>

			<!-- ROW 2: LOCKED SIDEBAR & SCROLLABLE MAIN CONTENT -->
			{isEvalsPage ? (
				<EvalsSidebar activeView={activeView} activeRunId={activeRunId} />
			) : (
				<Sidebar />
			)}
			<main class="content-viewport" style="view-transition-name: main-pane">
				<slot />
				<footer>
					<p>&copy; 2026 Josh Oney. All rights reserved.</p>
				</footer>
			</main>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0b0d10;
		--card-bg: #14181f;
		--text-main: #f0f4f8;
		--text-muted: #8b949e;
		
		/* Readable LCARS Palette */
		--lcars-amber: #ff9900;
		--lcars-blue: #6699cc;
		--lcars-purple: #cc6699;
		--lcars-red: #cc4444;
		--lcars-tan: #ffcc99;
		--lcars-dark: #1a1e24;

		--font-mono: 'Courier New', Courier, monospace;
		--font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: var(--font-sans);
		line-height: 1.6;
		overflow: hidden; /* Prevents outer page scrolling */
	}

	a {
		text-decoration: none;
		color: inherit;
		transition: opacity 0.2s ease, color 0.2s ease;
	}

	/* Master LCARS Viewport-Locked Layout */
	.lcars-frame {
		display: grid;
		grid-template-columns: 300px 1fr;
		grid-template-rows: 70px 1fr;
		gap: 0; /* Zero gap physically fuses the top sweep and sidebar */
		height: 100vh;
		width: 100vw;
		background-color: var(--bg-color);
	}

	/* Top Swoop Architecture */
	.lcars-elbow-top {
		width: 100%;
		height: 100%;
		background-color: var(--lcars-amber);
		border-top-left-radius: 35px;
	}

	.lcars-swoop-ext {
		position: relative;
		width: 100%;
		height: 40px; /* Leaves a 30px step down to match the 70px top row */
		align-self: start;
		background-color: var(--lcars-amber);
		border-bottom-right-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding-right: 35px;
	}

	/* LCARS Smooth Inner Concave Curve (Fillet) */
	.lcars-swoop-ext::after {
		content: "";
		position: absolute;
		left: 0;
		top: 40px; /* Sits directly in the 30px step below the horizontal bar */
		width: 30px;
		height: 30px;
		/* Carves an inward arc using a transparent circle centered at bottom-right */
		background: radial-gradient(circle at 100% 100%, transparent 29.5px, var(--lcars-amber) 30px);
		pointer-events: none;
	}

	.status-text {
		font-family: var(--font-mono);
		font-weight: bold;
		font-size: 0.85rem;
		color: #000;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	/* Content Area - Independent Scrolling Viewport */
	.content-viewport {
		padding: 30px 6% 40px 45px;
		height: calc(100vh - 70px);
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	/* Footer */
	footer {
		text-align: center;
		padding-top: 60px;
		margin-top: 60px;
		border-top: 1px solid #21262d;
		color: var(--text-muted);
		font-size: 0.85rem;
		font-family: var(--font-mono);
	}

	/* LCARS Scrollbars */
	::-webkit-scrollbar {
		width: 12px;
		height: 12px;
	}
	::-webkit-scrollbar-track {
		background: #0d1117;
		border-left: 1px solid #21262d;
	}
	::-webkit-scrollbar-thumb {
		background: var(--lcars-amber);
		border-radius: 6px;
		border: 3px solid #0d1117;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--lcars-tan);
	}
	::-webkit-scrollbar-corner {
		background: #0d1117;
	}

	/* Mobile Responsive */
	@media (max-width: 850px) {
		body {
			overflow: auto;
		}
		.lcars-frame {
			grid-template-columns: 1fr;
			grid-template-rows: auto;
			height: auto;
		}
		.lcars-elbow-top, .lcars-swoop-ext {
			display: none;
		}
		.content-viewport {
			height: auto;
			overflow-y: visible;
			padding: 20px 5%;
	}

	/* Custom View Transitions */
	::view-transition-old(main-pane),
	::view-transition-old(sidebar-pane) {
		animation: slideUpOut 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}
	::view-transition-new(main-pane),
	::view-transition-new(sidebar-pane) {
		animation: slideDownIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
	}

	@keyframes slideUpOut {
		from { transform: translateY(0); opacity: 1; }
		to { transform: translateY(-100px); opacity: 0; }
	}
	@keyframes slideDownIn {
		from { transform: translateY(-100px); opacity: 0; }
		to { transform: translateY(0); opacity: 1; }
	}
</style>