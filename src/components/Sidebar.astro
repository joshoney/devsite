---
const navLinks = [
	{ title: 'Local LLM Benchmarks', href: '#benchmarks', color: 'var(--lcars-amber)' },
	{ title: 'Local Evals', href: '#evals', color: 'var(--lcars-blue)' },
	{ title: 'Games', href: '#games', color: 'var(--lcars-purple)' },
	{ title: 'Action 04', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 05', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 06', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 07', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 08', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 09', href: '#', color: 'var(--lcars-dark)' },
];
---

<aside class="lcars-sidebar">
	<!-- Top LCARS Elbow -->
	<div class="elbow-top">
		<div class="elbow-top-left"></div>
		<div class="elbow-top-right">
			<span class="system-title">LCARS // SYS-409</span>
		</div>
	</div>

	<!-- Navigation Stack -->
	<nav class="nav-stack">
		{navLinks.map((link, index) => (
			<a 
				href={link.href} 
				class="lcars-btn" 
				style={`--btn-color: ${link.color};`}
			>
				<span class="btn-num">0{index + 1}</span>
				<span class="btn-text">{link.title}</span>
			</a>
		))}
	</nav>

	<!-- Bottom filler block to complete the frame -->
	<div class="sidebar-filler"></div>
</aside>

<style>
	.lcars-sidebar {
		display: flex;
		flex-direction: column;
		padding: 20px 0 20px 20px;
		user-select: none;
	}

	/* Elbow Architecture */
	.elbow-top {
		display: flex;
		height: 70px;
		margin-bottom: 10px;
	}

	.elbow-top-left {
		width: 120px;
		height: 100%;
		background-color: var(--lcars-amber);
		border-top-left-radius: 35px;
	}

	.elbow-top-right {
		flex-grow: 1;
		height: 35px;
		background-color: var(--lcars-amber);
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding-right: 15px;
		border-top-right-radius: 4px;
	}

	.system-title {
		font-family: var(--font-mono);
		font-weight: bold;
		font-size: 0.8rem;
		color: #000;
		letter-spacing: 2px;
	}

	/* Navigation Buttons */
	.nav-stack {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding-right: 15px;
	}

	.lcars-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 42px;
		background-color: var(--btn-color);
		color: #000;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 0 15px;
		border-top-left-radius: 21px;
		border-bottom-left-radius: 21px;
		border-top-right-radius: 4px;
		border-bottom-right-radius: 4px;
		transition: filter 0.2s, transform 0.1s;
	}

	/* Make dark stub buttons white text for readability */
	.lcars-btn[style*="--lcars-dark"] {
		color: var(--text-muted);
	}

	.lcars-btn:hover {
		filter: brightness(1.2);
		transform: translateX(4px);
		color: #fff;
	}

	.btn-num {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		opacity: 0.7;
	}

	.sidebar-filler {
		flex-grow: 1;
		width: 80px;
		background-color: var(--lcars-blue);
		border-radius: 4px;
		margin-top: 10px;
		opacity: 0.3;
	}

	@media (max-width: 850px) {
		.lcars-sidebar {
			padding: 15px;
		}
		.elbow-top {
			display: none;
		}
		.nav-stack {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
			padding-right: 0;
		}
		.lcars-btn {
			border-radius: 20px;
			justify-content: center;
			gap: 8px;
		}
		.sidebar-filler {
			display: none;
		}
	}
</style>