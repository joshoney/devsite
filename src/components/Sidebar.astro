---
const navLinks = [
	{ title: 'Local LLM Benchmarks', href: '#benchmarks', color: 'var(--lcars-amber)' },
	{ title: 'Local Evals', href: '#evals', color: 'var(--lcars-blue)' },
	{ title: 'Games', href: '#games', color: 'var(--lcars-purple)' },
	{ title: 'Action 04', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 05', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 06', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 07', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 08', href: '#', color: 'var(--lcars-dark)' },
	{ title: 'Action 09', href: '#', color: 'var(--lcars-dark)' },
];
---

<aside class="lcars-sidebar">
	<!-- Navigation Stack -->
	<nav class="nav-stack">
		{navLinks.map((link, index) => (
			<a 
				href={link.href} 
				class="lcars-btn" 
				style={`--btn-color: ${link.color};`}
			>
				<span class="btn-num">0{index + 1}</span>
				<span class="btn-text">{link.title}</span>
			</a>
		))}
	</nav>

	<!-- Bottom filler block matching button width -->
	<div class="sidebar-filler"></div>
</aside>

<style>
	.lcars-sidebar {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 100%;
		height: 100%;
		user-select: none;
	}

	/* Navigation Buttons - Now uniformly 100% column width */
	.nav-stack {
		display: flex;
		flex-direction: column;
		gap: 8px;
		width: 100%;
	}

	.lcars-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		min-height: 48px;
		padding: 8px 18px;
		background-color: var(--btn-color);
		color: #000;
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		border-top-left-radius: 24px;
		border-bottom-left-radius: 24px;
		border-top-right-radius: 4px;
		border-bottom-right-radius: 4px;
		transition: filter 0.2s, transform 0.1s;
	}

	.lcars-btn[style*="--lcars-dark"] {
		color: var(--text-muted);
	}

	.lcars-btn:hover {
		filter: brightness(1.2);
		transform: translateX(4px);
		color: #fff;
	}

	.btn-num {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		opacity: 0.7;
		flex-shrink: 0;
	}

	.btn-text {
		/* Forces multi-line wrapped text to align right consistently */
		text-align: right;
		line-height: 1.15;
		margin-left: 10px;
	}

	/* Bottom filler now matches exact width of the buttons above it */
	.sidebar-filler {
		flex-grow: 1;
		width: 100%;
		min-height: 150px;
		background-color: var(--lcars-blue);
		border-top-left-radius: 4px;
		border-top-right-radius: 4px;
		border-bottom-left-radius: 24px;
		border-bottom-right-radius: 4px;
		opacity: 0.25;
	}

	@media (max-width: 850px) {
		.nav-stack {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		}
		.lcars-btn {
			border-radius: 20px;
			justify-content: center;
			gap: 8px;
		}
		.sidebar-filler {
			display: none;
		}
	}
</style>