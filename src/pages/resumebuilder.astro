---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ResumeBuilder | Josh Oney">
	<section class="project-view">
		<div class="project-header">
			<h1>ResumeBuilder</h1>
			<a href="https://github.com/joshoney/resumeBuilder" target="_blank" class="github-btn">View on GitHub ↗</a>
		</div>
		
		<div class="content-grid">
			<div class="text-block">
				<h2>What it is</h2>
				<p>A simple wrapper over the <a href="https://github.com/dialvarezs/neat-cv" target="_blank" style="color: var(--lcars-subdued-sienna); text-decoration: underline;">neat-cv</a> repository to programmatically manage my resume.</p>
				
				<h2>How it works</h2>
				<p>Rather than dealing with manual layout formatting in Word or static PDF editors, this project allows me to maintain my professional experience as structured code. It incorporates small stylistic adjustments and word changes tailored to my personal branding, enabling me to quickly generate, version-control, and update my resume seamlessly.</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.project-view {
		max-width: 900px;
		padding: 20px 0;
	}

	.project-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 3px solid var(--lcars-subdued-sienna);
		padding-bottom: 20px;
		margin-bottom: 30px;
	}

	.project-header h1 {
		font-size: 2.8rem;
		margin: 0;
		color: #fff;
		font-family: var(--font-sans);
		font-weight: 800;
	}

	.github-btn {
		background: var(--lcars-subdued-sienna);
		color: #000;
		padding: 10px 20px;
		font-family: var(--font-mono);
		font-weight: bold;
		border-radius: 4px;
		transition: filter 0.15s, transform 0.1s;
	}

	.github-btn:hover {
		filter: brightness(1.2);
		transform: scale(1.02);
	}

	.content-grid {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.text-block h2 {
		color: var(--lcars-subdued-sienna);
		font-family: var(--font-mono);
		font-size: 1.4rem;
		margin-bottom: 12px;
		letter-spacing: 1px;
	}

	.text-block p {
		font-size: 1.1rem;
		color: var(--text-main);
		margin-bottom: 25px;
		line-height: 1.7;
	}
</style>
